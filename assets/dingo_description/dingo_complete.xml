<mujoco model="dingo_d">
  <compiler angle="radian" meshdir="meshes"/>

  <option integrator="implicitfast" timestep="0.005"/>

  <default>
    <default class="dingo">
      <joint damping="0.1" frictionloss="0.05"/>
      <geom friction="1.0 0.005 0.0001"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>
  </default>

  <asset>
    <!-- Chassis mesh (using collision STL for both visual and collision) -->
    <mesh file="diff_chassis_collision.stl"/>
    
    <!-- Wheel mesh -->
    <mesh file="wheel.stl"/>
  </asset>

  <worldbody>
    <!-- Base link (root, fixed to world) -->
    <body name="base_link" childclass="dingo">
      <!-- Chassis link -->
      <body name="chassis_link" pos="0 0 0">
        <inertial pos="0 0 0" mass="10.0" 
          diaginertia="0.2216 0.2458 0.4474"/>
        
        <!-- Visual (using collision mesh for now) -->
        <geom class="visual" mesh="diff_chassis_collision"/>
        
        <!-- Collision -->
        <geom class="collision" type="mesh" mesh="diff_chassis_collision"/>
        
        <!-- Left wheel -->
        <body name="left_wheel_link" pos="0.0989838 0.118001 0.0345">
          <inertial pos="0 0 0" mass="0.111"
            diaginertia="0.0003234 0.0003234 0.00049015"/>
          <joint name="left_wheel" type="hinge" axis="0 1 0" 
            damping="0.01" frictionloss="0.01"/>
          
          <!-- Visual -->
          <geom class="visual" mesh="wheel"/>
          
          <!-- Collision: cylinder -->
          <geom class="collision" type="cylinder" size="0.049 0.01016" 
            quat="0.7071068 0.7071068 0 0"/>
        </body>
        
        <!-- Right wheel -->
        <body name="right_wheel_link" pos="0.0989838 -0.118001 0.0345">
          <inertial pos="0 0 0" mass="0.111"
            diaginertia="0.0003234 0.0003234 0.00049015"/>
          <joint name="right_wheel" type="hinge" axis="0 1 0"
            damping="0.01" frictionloss="0.01"/>
          
          <!-- Visual -->
          <geom class="visual" mesh="wheel"/>
          
          <!-- Collision: cylinder -->
          <geom class="collision" type="cylinder" size="0.049 0.01016"
            quat="0.7071068 0.7071068 0 0"/>
        </body>
        
        <!-- Rear caster (passive wheel) -->
        <body name="rear_caster" pos="-0.244 0 -0.00674">
          <inertial pos="0 0 0" mass="0.1"
            diaginertia="0.001 0.001 0.001"/>
          
          <!-- Small sphere for caster -->
          <geom type="sphere" size="0.01" class="collision" 
            friction="0.2 0.005 0.0001"/>
        </body>
        
        <!-- IMU link (virtual sensor mount) -->
        <body name="imu_link" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.001"
            diaginertia="1e-09 1e-09 1e-09"/>
        </body>
        
        <!-- Mounting points for sensors/accessories -->
        <site name="front_mount" pos="0.200 0 0.064263" quat="1 0 0 0"/>
        <site name="rear_mount" pos="-0.200 0 0.064263" quat="0 0 0 1"/>
        <site name="front_bumper_mount" pos="0.274 0 0.0345125" quat="1 0 0 0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Velocity-controlled motors for differential drive -->
    <velocity name="left_motor" joint="left_wheel" 
      kv="100" ctrlrange="-10 10" forcerange="-20 20"/>
    <velocity name="right_motor" joint="right_wheel" 
      kv="100" ctrlrange="-10 10" forcerange="-20 20"/>
  </actuator>

  <sensor>
    <!-- IMU sensor -->
    <framepos name="imu_pos" objtype="body" objname="imu_link"/>
    <framequat name="imu_quat" objtype="body" objname="imu_link"/>
    <gyro name="imu_gyro" site="front_mount"/>
    <accelerometer name="imu_accel" site="front_mount"/>
  </sensor>

  <keyframe>
    <!-- Home position: stationary -->
    <key name="home" qpos="0 0" ctrl="0 0"/>
  </keyframe>
</mujoco>
