<mujoco model="hsr_tidyup">
  <include file="./env_hsr_common.xml"/>

  <asset>
    <texture name="bottle" file="general/metal2.png" type="cube"/>
    <material name="bottle1" texture="bottle" rgba="0.1 0.5 0.8 1.0" specular="1.0" shininess="1.0"/>
    <material name="bottle2" texture="bottle" rgba="0.8 0.1 0.5 1.0" specular="1.0" shininess="1.0"/>
    <texture name="container1" type="cube" file="general/wood1.png"/>
    <material name="container1" texture="container1" rgba="0.1 0.5 0.1 1.0" specular="0.2" shininess="0.3"/>
    <texture name="container2" type="cube" file="general/wood1.png"/>
    <material name="container2" texture="container2" rgba="0.5 0.1 0.1 1.0" specular="0.2" shininess="0.3"/>
  </asset>

  <include file="../../robots/hsr/hsr_config.xml"/>

  <keyframe>
    <!-- qpos (18): base(3), arm(5), gripper(1), mimics(2), bottle2_freejoint(7) -->
    <key name="init" qpos="-0.176 0 0 0.26 -2.4844 0.0039 1.0132 0.0021 0.8 0.8 0.8 0.44 0.08 0.01 1 0 0 0"/>
  </keyframe>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="floor" pos="0 0 0.0"/>

    <geom name="wall1" type="box" size="10 10 0.01" pos="10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall2" type="box" size="10 10 0.01" pos="-10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall3" type="box" size="10 10 0.01" pos="0 10 10" zaxis="0 1 0" material="wall"/>
    <geom name="wall4" type="box" size="10 10 0.01" pos="0 -10 10" zaxis="0 1 0" material="wall"/>

    <include file="../../robots/hsr/hsr_body.xml"/>
    <!-- Relay baton: upper half red (A), lower half blue (B); same outer size as before -->
    <body name="bottle2" pos="0.37 0.08 0.01">
      <freejoint name="bottle2_freejoint"/>
      <geom name="baton_upper" type="box" size="0.025 0.025 0.035" pos="0 0 0.105"
            rgba="0.95 0.08 0.08 1"
            condim="4" friction="1.5 0.05 0.005"
            solimp="0.95 0.99 0.001" solref="0.004 1"/>
      <geom name="baton_lower" type="box" size="0.025 0.025 0.035" pos="0 0 0.035"
            rgba="0.08 0.2 0.95 1"
            condim="4" friction="1.5 0.05 0.005"
            solimp="0.95 0.99 0.001" solref="0.004 1"/>
    </body>

    <!-- Observation Cameras -->
    <!-- side_view: looks from the right side diagonally toward the grasping area -->
    <camera name="side_view" pos="0.55 -0.7 0.35" xyaxes="1 0 0 0 0.3 1" fovy="65"/>
    <!-- overhead_view: closer top-down view to see both robot base position and target -->
    <camera name="overhead_view" pos="0.55 0.08 0.9" xyaxes="0 -1 0 1 0 0" fovy="70"/>

  </worldbody>
</mujoco>
