<mujoco model="dingo_z1_grasp">
  <include file="./env_dingo_z1_common.xml"/>

  <asset>
    <!-- Object materials -->
    <texture name="cube_tex" type="cube" file="general/metal2.png"/>
    <material name="cube_mat" texture="cube_tex" rgba="0.2 0.6 0.9 1.0" specular="1.0" shininess="1.0"/>
    <material name="target_mat" rgba="0.9 0.2 0.2 0.5" specular="0.3" shininess="0.3"/>
  </asset>

  <include file="../../robots/dingo_z1/dingo_z1_body.xml"/>

  <worldbody>
    <!-- Multiple cameras to match standard baseline datasets -->
    <camera name="front" pos="1.3 0.0 1.2" mode="targetbody" target="object" fovy="45"/>
    <camera name="left_side" pos="0.5 0.8 1.0" mode="targetbody" target="object" fovy="45"/>
    <camera name="right_side" pos="0.5 -0.8 1.0" mode="targetbody" target="object" fovy="45"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3" castshadow="false"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="floor" pos="0 0 0.0"/>

    <!-- Walls -->
    <geom name="wall1" type="box" size="10 10 0.01" pos="10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall2" type="box" size="10 10 0.01" pos="-10 0 10" zaxis="1 0 0" material="wall"/>
    <geom name="wall3" type="box" size="10 10 0.01" pos="0 10 10" zaxis="0 1 0" material="wall"/>
    <geom name="wall4" type="box" size="10 10 0.01" pos="0 -10 10" zaxis="0 1 0" material="wall"/>

    <!-- Work table in front of robot -->
    <body name="table" pos="0.7 0.0 0.25">
      <geom type="box" size="0.25 0.3 0.01" material="cube_mat" friction="2.0 0.1 0.001" mass="10"/>
      <!-- Table legs -->
      <geom type="cylinder" size="0.02 0.25" pos="0.2 0.25 -0.25" rgba="0.3 0.3 0.3 1"/>
      <geom type="cylinder" size="0.02 0.25" pos="-0.2 0.25 -0.25" rgba="0.3 0.3 0.3 1"/>
      <geom type="cylinder" size="0.02 0.25" pos="0.2 -0.25 -0.25" rgba="0.3 0.3 0.3 1"/>
      <geom type="cylinder" size="0.02 0.25" pos="-0.2 -0.25 -0.25" rgba="0.3 0.3 0.3 1"/>
      <!-- Table edge rails -->
      <geom type="box" size="0.25 0.005 0.015" pos="0.0 0.295 0.02" rgba="0.4 0.4 0.4 1"/>
      <geom type="box" size="0.25 0.005 0.015" pos="0.0 -0.295 0.02" rgba="0.4 0.4 0.4 1"/>
      <geom type="box" size="0.005 0.3 0.015" pos="0.245 0.0 0.02" rgba="0.4 0.4 0.4 1"/>
    </body>

    <!-- Graspable object (cylinder standing upright on table) -->
    <body name="object" pos="0.7 0.1 0.30">
      <freejoint name="object_freejoint"/>
      <geom type="cylinder" size="0.02 0.04" material="cube_mat" mass="0.8" friction="1.5 0.05 0.001" condim="4"/>
    </body>

    <!-- Target location on table -->
    <body name="target" pos="0.7 -0.1 0.265">
      <geom type="box" size="0.05 0.05 0.005" material="target_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Lock the Dingo mobile base for grasping data collection -->
  <equality>
    <weld body1="base_link" />
  </equality>
</mujoco>
