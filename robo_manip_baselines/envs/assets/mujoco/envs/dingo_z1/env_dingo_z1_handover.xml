    <body name="object" pos="-1.1 0.0 0.40">
      <freejoint name="object_freejoint"/>
      <!-- condim=4 激活扭转摩擦；friction第2项(0.3)=扭转摩擦、第3项(0.1)=滚动摩擦，防止轴向自转脱落 -->
